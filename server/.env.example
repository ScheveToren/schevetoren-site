# Copy to .env on the Pi (never commit .env or service-account JSON).

PORT=8787
HOST=127.0.0.1
TZ=Europe/Amsterdam

# SQLite path (absolute on Pi recommended)
SQLITE_PATH=./data/schevetoren.sqlite

# Same spreadsheet as Apps Script SHEET_ID
SHEET_ID=1tj5ZwW3U0D5IsXyuimu7Yv7tAuGAbuoW4-3POTtSwew

# Google service account JSON key path (share the Sheet with the SA email as Editor)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json

# Sync intervals
SHEETS_SYNC_INTERVAL_MS=120000
SHEETS_PUSH_DEBOUNCE_MS=3000
SHEETS_SYNC_ENABLED=true

# GitHub CMS (contents:write on ScheveToren/schevetoren-site)
GITHUB_PAT=
GITHUB_OWNER=ScheveToren
GITHUB_REPO=schevetoren-site
GITHUB_BRANCH=main

# CORS origins (comma-separated)
CORS_ORIGINS=https://schevetoren.github.io,http://localhost:8765,http://127.0.0.1:8765

# Optional contact-form recipient override (comma-separated). Leave empty to use
# spreadsheet tab Admins (email) + Players with is_admin and an email column.
# CONTACT_TO=

# Public site base for magic-link e-mails (no trailing slash)
# PUBLIC_SITE_URL=https://schevetoren.github.io/schevetoren-site

# SMTP for contact-form + magic-link login e-mails on the Pi
# (Apps Script failover uses MailApp instead)
# CONTACT_SMTP_HOST=smtp.example.com
# CONTACT_SMTP_PORT=587
# CONTACT_SMTP_SECURE=false
# CONTACT_SMTP_USER=
# CONTACT_SMTP_PASS=
# CONTACT_SMTP_FROM="De Scheve Toren <noreply@example.com>"
